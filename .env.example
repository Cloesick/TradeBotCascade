# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Security
# Set ENVIRONMENT=production to require SECRET_KEY (the app refuses to start
# without it). In development an ephemeral key is generated if SECRET_KEY is unset.
ENVIRONMENT=development
# Generate a stable value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (if you add one later)
# DATABASE_URL=postgresql://user:password@localhost:5432/tradebot

# Alpha Vantage API Key - Get free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=demo
